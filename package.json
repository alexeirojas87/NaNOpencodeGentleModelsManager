{
  "name": "model-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard for OpenCode provider/model config and gentle-ai orchestration assignments",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch server/src/index.ts\" \"vite --config vite.config.ts web\"",
    "build": "vite build --config vite.config.ts web",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
