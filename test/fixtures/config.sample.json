{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN",
      "options": {
        "baseURL": "https://api.nan.example/v1",
        "apiKey": "sk-synthetic-nan-placeholder-do-not-use"
      },
      "models": {
        "glm5.3-flash": {
          "name": "GLM 5.3 Flash",
          "contextWindow": 262144,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.6": {
          "name": "Qwen 3.6",
          "contextWindow": 262144,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.8-flash": {
          "name": "Qwen 3.8 Flash",
          "contextWindow": 1000000,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "mimo-v2.5": {
          "name": "MiMo v2.5",
          "contextWindow": 262144
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "contextWindow": 163840
        },
        "gemma4": {
          "name": "Gemma 4",
          "contextWindow": 131072
        }
      }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom",
      "options": {
        "baseURL": "https://api.headroom.example/v1"
      },
      "models": {}
    },
    "nanSendvalu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN Sendvalu",
      "options": {
        "baseURL": "https://api.nan-sendvalu.example/v1",
        "apiKey": ""
      },
      "models": {
        "claude-synthetic-1": {
          "name": "Claude Synthetic 1"
        }
      }
    }
  },
  "default_agent": "gentle-orchestrator",
  "agent": {
    "gentle-orchestrator": {
      "description": "Top-level orchestrator (synthetic)",
      "model": "nan/qwen3.8-flash"
    },
    "sdd-spec": {
      "model": "nan/glm5.3-flash"
    },
    "sdd-spec-cheap": {
      "description": "Cheap variant (synthetic)"
    },
    "sdd-spec-deep": {},
    "jd-judge-a": {
      "model": "nan/qwen3.8-flash"
    },
    "review-security": {
      "description": "Review agent (synthetic)"
    }
  },
  "compaction": {
    "reserved": "unknown key — must survive every write"
  },
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "example-server": {
      "type": "local",
      "command": [
        "example"
      ],
      "enabled": false
    }
  },
  "share": "manual",
  "custom": {
    "note": "unknown top-level key — must survive every write"
  }
}